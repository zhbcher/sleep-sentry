<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SleepSentry" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/onBrand</item>
        <item name="colorSecondary">@color/brandDim</item>
        <item name="colorOnSecondary">@color/onBrand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surfaceRaised</item>
        <item name="colorOnSurfaceVariant">@color/textDim</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brandDark</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="SecondaryActionButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/surfaceSoft</item>
        <item name="android:textColor">@color/brand</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
